_etc_overrides_apply() {
  echo "Applying Omarchy etc-overrides..."

  # Ensure parent dirs exist. cups-browsed may not be installed yet during ISO
  # bootstrap; do not create /etc/cups/cups-browsed.conf before the package is
  # installed or pacman will preserve its packaged file as a noisy .pacnew.
  # cups owns /etc/cups/cups-files.conf, so only overlay it when that file
  # already exists.
  install -d /etc/plymouth /etc/security /etc/skel

  # NOTE: these cp -f's are intentionally destructive on every install/upgrade.
  # Users who customize /etc/os-release, /etc/plymouth/plymouthd.conf (theme
  # switch), /etc/cups/cups-browsed.conf, /etc/cups/cups-files.conf,
  # /etc/nsswitch.conf, /etc/security/faillock.conf, or /etc/skel/.bashrc WILL
  # have their changes reset to Omarchy defaults each time omarchy-settings-dev
  # is upgraded. This is the trade-off of routing upstream-owned paths through
  # etc-overrides instead of pacman backup=().
  rm -f /etc/os-release
  cp -f /usr/share/omarchy/etc-overrides/os-release              /etc/os-release
  cp -f /usr/share/omarchy/etc-overrides/security-faillock.conf  /etc/security/faillock.conf
  cp -f /usr/share/omarchy/etc-overrides/nsswitch.conf           /etc/nsswitch.conf
  if [[ -f /etc/cups/cups-browsed.conf ]]; then
    install -d /etc/cups
    cp -f /usr/share/omarchy/etc-overrides/cups-cups-browsed.conf /etc/cups/cups-browsed.conf
  fi
  if [[ -f /usr/share/omarchy/etc-overrides/cups-cups-files.conf && -f /etc/cups/cups-files.conf ]]; then
    install -m 0640 -o root -g cups /usr/share/omarchy/etc-overrides/cups-cups-files.conf /etc/cups/cups-files.conf
    rm -f /etc/cups/cups-files.conf.pacnew
  fi
  cp -f /usr/share/omarchy/etc-overrides/plymouth-plymouthd.conf /etc/plymouth/plymouthd.conf
  cp -f /usr/share/omarchy/etc-overrides/dot.bashrc              /etc/skel/.bashrc
  chmod 0644 /etc/os-release /etc/security/faillock.conf /etc/nsswitch.conf \
             /etc/plymouth/plymouthd.conf /etc/skel/.bashrc
  if [[ -f /etc/cups/cups-browsed.conf ]]; then
    chmod 0644 /etc/cups/cups-browsed.conf
  fi
}

_passwordless_sudo_cleanup() (
  local complete=${1:-0} file
  # Announce the transaction before waiting for the same lock as publishers.
  # Scriptlet errors do not abort pacman, so failures must leave this blocker.
  (umask 077; : >/run/omarchy-sudo-passwordless-package-removing) || return 1
  [[ -d /run/lock && ! -L /run/lock ]] || return 1
  [[ $(/usr/bin/stat -Lc '%u' /run/lock) == 0 ]] || return 1
  ! ((8#$(/usr/bin/stat -Lc '%a' /run/lock) & 022)) || return 1
  exec 9>/run/lock/omarchy-sudo-passwordless.lock || return 1
  chmod 0600 /run/lock/omarchy-sudo-passwordless.lock || return 1
  /usr/bin/flock -x -w 60 9 || return 1
  # Fallback for older installations without the pre-transaction hook.
  set +f
  unset GLOBIGNORE
  shopt -s nullglob
  for file in /etc/sudoers.d/99-omarchy-nopasswd-*; do
    /usr/bin/rm -f -- "$file" || return 1
    [[ ! -e $file && ! -L $file ]] || return 1
  done
  if (( complete )); then
    [[ -f /etc/tmpfiles.d/omarchy-nopasswd-sudo.conf && -f /usr/share/libalpm/hooks/05-omarchy-passwordless-revoke.hook ]] || return 1
    /usr/bin/rm -f /run/omarchy-sudo-passwordless-package-removing || return 1
  fi
)

pre_upgrade() {
  _passwordless_sudo_cleanup
}

pre_remove() {
  _passwordless_sudo_cleanup
}

post_remove() {
  _passwordless_sudo_cleanup
}

post_install() {
  _passwordless_sudo_cleanup 1 || return 1
  _etc_overrides_apply
}

post_upgrade() {
  post_install
}
